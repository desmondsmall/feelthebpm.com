# The .dev/ Obsidian vault is local-only: design docs, decision records, and the
# gitignored dangerous/ secrets. Kept out of the repo entirely so infra notes
# (droplet IP, ssh user, server paths) never ship with a public checkout.
.dev/

.obsidian/
.DS_Store
.claude/

# build pipeline cache (regenerable HTTP responses)
pipeline/cache/

# raw manual harvests (e.g. Ultimate Guitar page dumps). Bulky intermediates — the PARSED
# output (pipeline/seed-ug.json) is the committed artifact; these raw dumps are not.
pipeline/raw/

# curation-tool review sidecar (regenerable per build; carries Deezer preview URLs)
pipeline/generated/review.json
