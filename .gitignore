# Local secrets (GetSongBPM key). Load with `node --env-file=.env ...`.
.env

# The old .dev/ Obsidian vault, superseded by .mind/ but still present in older checkouts.
# Kept ignored so infra notes (droplet IP, ssh user, server paths) never ship publicly.
.dev/

.obsidian/
.DS_Store
.claude/

# build pipeline cache (regenerable HTTP responses)
pipeline/cache/

# raw manual harvests (e.g. Ultimate Guitar page dumps). Bulky intermediates — the PARSED
# output (pipeline/seed-ug.json) is the committed artifact; these raw dumps are not.
pipeline/raw/

# curation-tool review sidecar (regenerable per build; carries Deezer preview URLs)
pipeline/generated/review.json

# The agent's mind (mind plugin), kept out of this repo
.mind/

# written by deploys: the commit the search endpoint is running
api/COMMIT
